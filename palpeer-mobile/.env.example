# Copy to .env.development / .env.staging / .env.production (never commit real values).
# Android emulator: http://10.0.2.2:8085/api/v1 · physical device: use your machine's LAN IP.
# Render preview/production: https://palpeer-api.onrender.com/api/v1 (also set in eas.json preview).
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:8085/api/v1
# SockJS endpoint; native clients use /ws/websocket (brokerUrl appends /websocket if needed).
# Local: ws://192.168.0.10:8085/ws/websocket · Render: https://palpeer-api.onrender.com/ws
EXPO_PUBLIC_WS_URL=ws://192.168.0.10:8085/ws/websocket
# development | staging | production
EXPO_PUBLIC_ENV=development
# Support and legal details shown in Help and Privacy.
# Email defaults to support@palpeer.com when unset. Phone/URLs are optional; URLs must be https.
EXPO_PUBLIC_SUPPORT_EMAIL=support@palpeer.com
EXPO_PUBLIC_SUPPORT_PHONE=
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=
# AI Live Chat (Support-Ticketing App). Docs: https://app.palpeer.com.ng/swagger/index.html#/AI
# Native builds call this URL directly. Expo web uses Metro proxy /support-chat-api (restart Expo after changes).
EXPO_PUBLIC_SUPPORT_CHAT_API_BASE_URL=https://app.palpeer.com.ng/api
# Google Sign-In (Web client ID required for ID tokens). Leave empty to hide the Google button.
# Backend GOOGLE_CLIENT_IDS must include the same client IDs.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# HTTPS origin for P2P share links (App Links). When unset, shares use palpeer:// scheme.
# Path is always /p2p/share/<requestId>. Example: https://app.palpeer.com
EXPO_PUBLIC_SHARE_BASE_URL=
# Store fallbacks when the share link opens in a browser without the app installed.
EXPO_PUBLIC_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.palpeer.app
EXPO_PUBLIC_IOS_STORE_URL=
