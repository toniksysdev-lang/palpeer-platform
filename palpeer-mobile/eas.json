{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": { "EXPO_PUBLIC_ENV": "development" },
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ENV": "staging",
        "EXPO_PUBLIC_API_BASE_URL": "https://palpeer-api.onrender.com/api/v1",
        "EXPO_PUBLIC_WS_URL": "https://palpeer-api.onrender.com/ws",
        "EXPO_PUBLIC_SHARE_BASE_URL": "https://app.palpeer.com",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ENV": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://palpeer-api.onrender.com/api/v1",
        "EXPO_PUBLIC_WS_URL": "https://palpeer-api.onrender.com/ws",
        "EXPO_PUBLIC_SHARE_BASE_URL": "https://app.palpeer.com",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "GXZ92PPYUW",
        "ascAppId": "6826088742",
        "appleId": "palpeerglobal@gmail.com",
        "sku": "palpeer-app-ios",
        "language": "en-US",
        "companyName": "Palpeer Global Holdings Inc."
      }
    }
  }
}
