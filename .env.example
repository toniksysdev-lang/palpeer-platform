# Copy to `.env` and fill in values. Do not commit real passwords.

SPRING_PROFILES_ACTIVE=dev

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=palpeer
DB_USER=palpeer
DB_PASSWORD=palpeer
DB_SSLMODE=disable
DB_POOL_MAX=10
DB_POOL_MIN=2

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# App
SERVER_PORT=8085
JWT_SECRET=CHANGE_ME_PALPEER_DEV_JWT_SECRET_AT_LEAST_32_CHARS
ADMIN_BOOTSTRAP_EMAIL=
# Public API origin for emailed security links (new-device suspend). No trailing slash.
PUBLIC_API_BASE_URL=http://localhost:8085
# Admin / Expo web origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:8081,http://127.0.0.1:8081

# OTP (email + SMS phone verification)
OTP_LENGTH=6
OTP_TTL=10m
OTP_MAX_ATTEMPTS=5
# When true, API may return debugOtp and codes are logged (dev only — keep false in prod).
OTP_LOG_CODE=true

# Password login lockout + IP rate limits on auth endpoints
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=15m
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_LOGIN=10
AUTH_RATE_LIMIT_OTP=5
AUTH_RATE_LIMIT_PASSWORD_RESET=5
AUTH_RATE_LIMIT_REGISTER=5

# When true, admins must enroll TOTP before using admin APIs (except /admin/me and /admin/mfa).
ADMIN_MFA_REQUIRED=false

# Google Sign-In (comma-separated OAuth client IDs: Web + Android + iOS). Empty disables the endpoint.
GOOGLE_CLIENT_IDS=

# ---------------------------------------------------------------------------
# SMS — enable exactly ONE live provider (telnyx | twilio | bulksms).
# Phone verification (POST /api/v1/auth/otp/phone/*) and pool-fund SMS notices
# use the active SmsSender. When none is configured, codes are logged only.
# ---------------------------------------------------------------------------

# Telnyx Messaging (https://developers.telnyx.com/docs/api/v2/messaging)
TELNYX_ENABLED=false
TELNYX_API_KEY=
TELNYX_API_URL=https://api.telnyx.com/v2
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_FROM_NUMBER=
TELNYX_TIMEOUT_MS=15000

# Twilio Programmable Messaging (https://www.twilio.com/docs/messaging/api)
# Requires FROM_NUMBER or MESSAGING_SERVICE_SID. Prefer API Key SID/Secret over AUTH_TOKEN.
TWILIO_ENABLED=false
TWILIO_FRIENDLY_NAME=
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_TIMEOUT_MS=15000

# BulkSMS JSON REST (https://www.bulksms.com/developer/json/v1/)
# Auth: HTTP Basic with Token ID (username) + Token Secret (password)
BULKSMS_ENABLED=false
BULKSMS_TOKEN_ID=
BULKSMS_TOKEN_SECRET=
BULKSMS_BASE_URL=https://api.bulksms.com/v1
BULKSMS_SENDER=Palpeer
BULKSMS_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Mail (SendPulse)
# ---------------------------------------------------------------------------
# From-domain must be authenticated in SendPulse (SPF include:mxsspf.sendpulse.com
# + sign._domainkey DKIM) or mail will fail DMARC and land in spam.
# See docs/mail-deliverability.md
#
# provider: auto | sendpulse | smtp
# Prefer SendPulse REST (HTTPS) on PaaS; SMTP kept for local fallback.
PALPEER_MAIL_PROVIDER=auto
PALPEER_MAIL_FROM=noreply@palpeer.com
PALPEER_MAIL_FROM_NAME=Palpeer
# Reply-To (monitored). Prefer support@…; do not mirror noreply@.
PALPEER_MAIL_HEADER_FROM=support@palpeer.com

# SendPulse REST — Settings → API (ID + Secret).
# Leave both empty to use PALPEER_SMTP_USERNAME / PASSWORD as OAuth client_id / secret.
PALPEER_SENDPULSE_ENABLED=false
PALPEER_SENDPULSE_CLIENT_ID=
PALPEER_SENDPULSE_CLIENT_SECRET=
PALPEER_SENDPULSE_BASE_URL=https://api.sendpulse.com

# SMTP — local fallback, and OAuth login when CLIENT_* above are empty
PALPEER_SMTP_HOST=smtp-pulse.com
PALPEER_SMTP_PORT=587
PALPEER_SMTP_USERNAME=
PALPEER_SMTP_PASSWORD=
PALPEER_SMTP_SSL=true

# ComplyCube KYC (https://www.complycube.com/en/developers/)
COMPLYCUBE_ENABLED=true
COMPLYCUBE_API_KEY=
COMPLYCUBE_BASE_URL=https://api.complycube.com/v1
COMPLYCUBE_WEBHOOK_SECRET=

# Apaylo CAD funding/withdrawal (https://docs.apaylo.com/)
APAYLO_ENABLED=false
APAYLO_SANDBOX=true
# Withdrawal sandbox settle only. Funding never auto-credits on poll (webhook/operator only).
APAYLO_AUTO_SANDBOX_SETTLE=false
APAYLO_OFFLINE_SANDBOX_SETTLE=true
APAYLO_API_KEY=
APAYLO_SHARED_KEY=
APAYLO_BASE_URL=https://api.etransfer.apaylo.com/api.apaylo.com/api
APAYLO_SANDBOX_BASE_URL=https://sandboxapi.apaylo.com/sandboxapi.apaylo.com/api
# Searchable Interac account name customers send to (banking-app search).
APAYLO_ACCOUNT_ID=Palpeer Global Holding Inc
# CAD Instant Interac destination email shown on funding payment details.
APAYLO_INTERAC_COLLECTION_EMAIL=ipay@apaylo.com
# Optional APL#### required in Instant deposit Description (Apaylo docs).
APAYLO_APL_REFERENCE=
# Instant deposit checkout (no request email). Do not use RequestInteracEtransferEmail.
APAYLO_CREATE_SEARCHABLE_PATH=/Merchant/RequestInteracEtransferLink
APAYLO_SEND_INTERAC_PATH=/Merchant/SendInteracEtransfer
APAYLO_SEND_EFT_PATH=/EFT/CreateEFTTransaction
APAYLO_INTERAC_SECURITY_QUESTION=What is the name of this transfer?
APAYLO_INTERAC_SECURITY_ANSWER=PALPEER
APAYLO_ACCOUNT_BALANCE_PATH=/Merchant/GetBalance
APAYLO_WEBHOOK_SECRET=
APAYLO_WEBHOOK_SIGNATURE_HEADER=X-Webhook-Signature

# Kuda NGN funding/withdrawal (https://www.kuda.com/business/open-api/)
# UAT: https://kuda-openapi-uat.kudabank.com/v2.1  Live: https://kuda-openapi.kuda.com/v2.1
KUDA_ENABLED=false
KUDA_SANDBOX=true
# Withdrawal sandbox settle only. Funding never auto-credits on poll (webhook/operator only).
KUDA_AUTO_SANDBOX_SETTLE=false
KUDA_OFFLINE_SANDBOX_SETTLE=true
# true = call Kuda FUND_VIRTUAL_ACCOUNT in sandbox; wallet still stays PENDING until webhook.
KUDA_DEMO_FUND_ENABLED=false
KUDA_EMAIL=
KUDA_API_KEY=
KUDA_BASE_URL=
KUDA_SENDER_NAME=PALPEER
# Kuda Business main account number — required for live withdrawals and dynamic collection remits.
KUDA_CLIENT_ACCOUNT_NUMBER=
# true = create a per-funding dynamic collection account (recommended for live).
KUDA_DYNAMIC_COLLECTION_FUNDING=true
# Live checklist: KUDA_ENABLED=true, KUDA_SANDBOX=false, clear BASE_URL (or set live host),
# OFFLINE/AUTO/DEMO settle flags false, webhook URL https://<api>/api/v1/webhooks/kuda.
# Kuda Business dashboard webhook username/password (preferred). HMAC secret is a local/test fallback.
KUDA_WEBHOOK_USERNAME=
KUDA_WEBHOOK_PASSWORD=
KUDA_WEBHOOK_SECRET=
KUDA_WEBHOOK_SIGNATURE_HEADER=X-Webhook-Signature

# Korapay NGN funding (bank transfer) + withdrawals (disburse to bank)
# Docs: https://developers.korapay.com/docs/bank-transfers
#       https://developers.korapay.com/docs/payout-via-api
# Prefer test keys + sandbox settle flags for local demos.
KORAPAY_ENABLED=false
KORAPAY_SANDBOX=true
KORAPAY_AUTO_SANDBOX_CREDIT=true
KORAPAY_AUTO_SANDBOX_SETTLE=true
KORAPAY_OFFLINE_SANDBOX_SETTLE=true
KORAPAY_PUBLIC_KEY=
KORAPAY_SECRET_KEY=
KORAPAY_BASE_URL=https://api.korapay.com
KORAPAY_WEBHOOK_SECRET=
KORAPAY_WEBHOOK_SIGNATURE_HEADER=x-korapay-signature

# Firebase Cloud Messaging (push). Requires service-account credentials when enabled.
# Mobile still uses expo-notifications; this wires backend delivery via Firebase Admin SDK.
PALPEER_FCM_ENABLED=false
# Absolute/relative path to the Firebase service-account JSON (local).
PALPEER_FCM_CREDENTIALS_FILE=
# Inline JSON string of the same service account (preferred on PaaS / Render). Overrides CREDENTIALS_FILE.
PALPEER_FCM_CREDENTIALS_JSON=
