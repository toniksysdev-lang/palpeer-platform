# Copy to `.env` and fill in values. Do not commit real passwords.

SPRING_PROFILES_ACTIVE=dev

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=palpeer
DB_USER=palpeer
DB_PASSWORD=palpeer
DB_SSLMODE=disable
DB_POOL_MAX=10
DB_POOL_MIN=2

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# App
SERVER_PORT=8085
JWT_SECRET=CHANGE_ME_PALPEER_DEV_JWT_SECRET_AT_LEAST_32_CHARS
OTP_LOG_CODE=true
ADMIN_BOOTSTRAP_EMAIL=
# Public API origin for emailed security links (new-device suspend). No trailing slash.
PUBLIC_API_BASE_URL=http://localhost:8085


# Google Sign-In (comma-separated OAuth client IDs: Web + Android + iOS). Empty disables the endpoint.
GOOGLE_CLIENT_IDS=

# Mail — prefer SendPulse REST (HTTPS) on PaaS; SMTP kept for local fallback.
# provider: auto | sendpulse | smtp
PALPEER_MAIL_PROVIDER=auto
PALPEER_SENDPULSE_ENABLED=false
# Optional overrides. When empty, SendPulse REST uses PALPEER_SMTP_USERNAME / PASSWORD as OAuth
# client_id / client_secret (SendPulse → Settings → API, or SMTP login from the SMTP section).
PALPEER_SENDPULSE_CLIENT_ID=
PALPEER_SENDPULSE_CLIENT_SECRET=
PALPEER_SENDPULSE_BASE_URL=https://api.sendpulse.com
# SMTP (also used as SendPulse REST login when SENDPULSE_CLIENT_* are empty)
PALPEER_SMTP_HOST=smtp-pulse.com
PALPEER_SMTP_PORT=587
PALPEER_SMTP_USERNAME=
PALPEER_SMTP_PASSWORD=
PALPEER_SMTP_SSL=true
PALPEER_MAIL_FROM=noreply@palpeer.com.ng
PALPEER_MAIL_FROM_NAME=PALPEER SUPPORT
PALPEER_MAIL_HEADER_FROM=noreply@palpeer.com.ng

# ComplyCube KYC (https://www.complycube.com/en/developers/)
COMPLYCUBE_ENABLED=true
COMPLYCUBE_API_KEY=
COMPLYCUBE_BASE_URL=https://api.complycube.com/v1
COMPLYCUBE_WEBHOOK_SECRET=

# Apaylo CAD funding/withdrawal (https://docs.apaylo.com/)
APAYLO_ENABLED=false
APAYLO_SANDBOX=true
APAYLO_AUTO_SANDBOX_SETTLE=true
APAYLO_OFFLINE_SANDBOX_SETTLE=true
APAYLO_API_KEY=
APAYLO_SHARED_KEY=
APAYLO_BASE_URL=https://api.etransfer.apaylo.com/api.apaylo.com/api
APAYLO_SANDBOX_BASE_URL=https://sandboxapi.apaylo.com/sandboxapi.apaylo.com/api
APAYLO_ACCOUNT_ID=
APAYLO_CREATE_SEARCHABLE_PATH=/Merchant/RequestInteracEtransferEmail
APAYLO_SEND_INTERAC_PATH=/Merchant/SendInteracEtransfer
APAYLO_SEND_EFT_PATH=/EFT/CreateEFTTransaction
APAYLO_INTERAC_SECURITY_QUESTION=What is the name of this transfer?
APAYLO_INTERAC_SECURITY_ANSWER=PALPEER
APAYLO_ACCOUNT_BALANCE_PATH=/Merchant/GetBalance
APAYLO_WEBHOOK_SECRET=
APAYLO_WEBHOOK_SIGNATURE_HEADER=X-Webhook-Signature

# Kuda NGN funding/withdrawal (https://www.kuda.com/business/open-api/)
KUDA_ENABLED=false
KUDA_SANDBOX=true
KUDA_EMAIL=
KUDA_API_KEY=
KUDA_BASE_URL=
KUDA_SENDER_NAME=PALPEER
KUDA_WEBHOOK_SECRET=
KUDA_WEBHOOK_SIGNATURE_HEADER=X-Webhook-Signature

# Korapay NGN funding (bank transfer) + withdrawals (disburse to bank)
# Docs: https://developers.korapay.com/docs/bank-transfers
#       https://developers.korapay.com/docs/payout-via-api
# Prefer test keys + sandbox settle flags for local demos.
KORAPAY_ENABLED=false
KORAPAY_SANDBOX=true
KORAPAY_AUTO_SANDBOX_CREDIT=true
KORAPAY_AUTO_SANDBOX_SETTLE=true
KORAPAY_OFFLINE_SANDBOX_SETTLE=true
KORAPAY_PUBLIC_KEY=
KORAPAY_SECRET_KEY=
KORAPAY_BASE_URL=https://api.korapay.com
KORAPAY_WEBHOOK_SECRET=
KORAPAY_WEBHOOK_SIGNATURE_HEADER=x-korapay-signature

# Firebase Cloud Messaging (push). Requires service-account credentials when enabled.
# Mobile still uses expo-notifications; this wires backend delivery via Firebase Admin SDK.
PALPEER_FCM_ENABLED=false
# Absolute/relative path to the Firebase service-account JSON (local).
PALPEER_FCM_CREDENTIALS_FILE=
# Inline JSON string of the same service account (preferred on PaaS / Render). Overrides CREDENTIALS_FILE.
PALPEER_FCM_CREDENTIALS_JSON=
