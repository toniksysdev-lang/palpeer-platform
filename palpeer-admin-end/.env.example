# Prefer same-origin /api/v1 in dev (Vite proxies to Spring on :8085).
# Absolute http://localhost:8085/api/v1 also works when CORS is configured.
VITE_API_BASE_URL=/api/v1
VITE_WS_URL=http://localhost:8085/ws
VITE_APP_ENV=development
# Never enable in production builds (forced off when import.meta.env.PROD).
VITE_USE_MOCK_API=false
